# ---- À copier vers .env (à côté de docker-compose.yml) ----

# Générer avec (Linux/macOS/Git Bash) :  echo "base64:$(openssl rand -base64 32)"
# ou avec Docker (Windows) :  docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

DB_DATABASE=diary
DB_USERNAME=diary
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ---- URLs (démo locale) ----
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ---- Production (exemple) ----
# API_URL=https://api.tondomaine.mg
# FRONTEND_URL=https://app.tondomaine.mg
# SANCTUM_STATEFUL_DOMAINS=app.tondomaine.mg
# SESSION_DOMAIN=.tondomaine.mg
# SESSION_SECURE_COOKIE=true

# ---- Images publiées par la CI (serveur uniquement) ----
# BACKEND_IMAGE=ghcr.io/ton-user/diary-backend
# FRONTEND_IMAGE=ghcr.io/ton-user/diary-frontend
# IMAGE_TAG=latest
